{
  "name": "min-setliste-app",
  "version": "1.0.0",
  "description": "Setliste Planner til Linux",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dist": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.ulreg.setlistplanner",
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  }
}
